/* Estilos Globales */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Arial, sans-serif;
}

body {
    background-color: #f2f2f2;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* Cabecera */
.main-header {
    background: #fff;
    border-bottom: 4px solid #004a99;
    padding: 15px;
    text-align: center;
}

.header-title {
    color: #004a99;
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 1px;
}

/* Contenedor del Login */
.login-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.login-card {
    background: #fff;
    width: 100%;
    max-width: 400px;
    border-radius: 5px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    border: 1px solid #ddd;
    overflow: hidden;
}

.card-header {
    background: #004a99;
    color: #fff;
    padding: 12px;
    text-align: center;
    font-weight: bold;
}

.card-body {
    padding: 30px;
}

.system-title {
    text-align: center;
    margin-bottom: 25px;
    color: #444;
    font-size: 20px;
}

/* Formulario */
.form-group {
    margin-bottom: 15px;
}

.form-group label {
    display: block;
    font-size: 13px;
    margin-bottom: 5px;
    color: #666;
    font-weight: 600;
}

.input-control, .select-control {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    outline: none;
}

.input-control:focus {
    border-color: #004a99;
}

.helper-links {
    text-align: center;
    margin: 15px 0;
}

.helper-links a {
    font-size: 12px;
    color: #004a99;
    text-decoration: none;
}

/* Botones */
.actions-row {
    display: flex;
    justify-content: center;
    gap: 10px;
}

.btn {
    padding: 10px 25px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
}

.btn-ok { background: #004a99; color: #fff; }
.btn-cancel { background: #d9534f; color: #fff; }

/* Iconos de ayuda */
.icon-bar {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 25px;
}

.info-icon {
    width: 25px;
    height: 25px;
    border: 1px solid #004a99;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #004a99;
    font-size: 12px;
    font-weight: bold;
}

/* Footer */
.main-footer {
    padding: 20px;
    text-align: center;
    font-size: 11px;
    color: #888;
    background: #eee;
}
